---
import { Icon } from 'astro-icon/components'
import { useTranslations, getLangFromUrl } from '../i18n/utils'
import { PROFILE } from '../data/profile'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

const txt = {
  es: {
    intro: '¿Una página para tu negocio, un sistema de reservas o un backend que no se caiga? Contame en dos líneas.',
    nombre: 'Tu nombre',
    email: 'Tu correo',
    mensaje: 'Contame qué necesitás',
    ejemplo: 'ej: quiero una página para mi restaurante con el menú y el pedido por WhatsApp',
    tipo: '¿Qué necesitás? (elegí)',
    presupuesto: 'Presupuesto (opcional)',
    enviar: 'Enviarme el mensaje',
    ok: 'Listo, me llegó. Te contesto pronto.',
    error: 'No salió. Probá otra vez o escribime al correo.',
  },
  en: {
    intro: 'A website for your business, a booking system, or a backend that never falls over? Two lines is enough to start.',
    nombre: 'Your name',
    email: 'Your email',
    mensaje: 'Tell me what you need',
    ejemplo: 'e.g. I need a site for my restaurant with the menu and WhatsApp ordering',
    tipo: 'What do you need? (pick one)',
    presupuesto: 'Budget (optional)',
    enviar: 'Send message',
    ok: 'Got it. I will reply soon.',
    error: 'That failed. Try again or email me.',
  },
  fr: {
    intro: "Un site pour votre entreprise, un système de réservation ou un backend fiable ? Deux lignes suffisent.",
    nombre: 'Votre nom',
    email: 'Votre e-mail',
    mensaje: 'Dites-moi ce qu\'il vous faut',
    ejemplo: "ex : je veux un site pour mon restaurant avec le menu et la commande par WhatsApp",
    tipo: 'De quoi avez-vous besoin ? (choisissez)',
    presupuesto: 'Budget (facultatif)',
    enviar: 'Envoyer le message',
    ok: 'Reçu. Je réponds vite.',
    error: "Ça n'a pas marché. Réessayez ou écrivez-moi.",
  },
}[lang] ?? {
  intro: '',
  nombre: 'Nombre',
  email: 'Email',
  mensaje: 'Contame qué necesitás',
  ejemplo: '',
  tipo: '¿Qué necesitás?',
  presupuesto: 'Presupuesto (opcional)',
  enviar: 'Enviar',
  ok: 'Listo, me llegó.',
  error: 'No salió. Probá otra vez.',
}

const TIPOS = [
  { v: 'Página web', es: 'Una página web', en: 'A website', fr: 'Un site web' },
  { v: 'Sistema o app', es: 'Un sistema o app', en: 'A system or app', fr: 'Un système ou une app' },
  { v: 'Tienda con pagos', es: 'Una tienda con pagos', en: 'A store with payments', fr: 'Une boutique avec paiement' },
  { v: 'Arreglar algo', es: 'Arreglar algo que ya tengo', en: 'Fix something I already have', fr: "Réparer ce que j'ai déjà" },
  { v: 'No sé todavía', es: 'No sé todavía', en: 'Not sure yet', fr: 'Je ne sais pas encore' },
]
const PRESUPUESTOS = [
  { v: 'Menos de $300', es: 'Menos de $300', en: 'Under $300', fr: 'Moins de 300 $' },
  { v: '$300 - $800', es: '$300 – $800', en: '$300 – $800', fr: '300 – 800 $' },
  { v: '$800 - $1,500', es: '$800 – $1,500', en: '$800 – $1,500', fr: '800 – 1 500 $' },
  { v: 'Más de $1,500', es: 'Más de $1,500', en: 'Over $1,500', fr: 'Plus de 1 500 $' },
  { v: 'No sé', es: 'No sé / no es problema', en: 'Not sure / not an issue', fr: 'Je ne sais pas' },
]

const links = [
  { name: 'GitHub', icon: 'lucide:github', href: PROFILE.github, color: 'hover:text-white' },
  { name: 'LinkedIn', icon: 'lucide:linkedin', href: PROFILE.linkedin, color: 'hover:text-[#0077B5]' },
]
---

<section
  id="contact"
  class="col-span-12 md:col-span-6 lg:col-span-4 bento-card reveal flex flex-col justify-between"
>
  <div>
    <h2 class="text-2xl font-bold mb-4 text-white flex items-center gap-2 font-display">
      <Icon name="lucide:message-circle" class="size-6 text-sky-400" />
      {t('nav.contact')}
    </h2>
    <p class="text-neutral-400 text-sm leading-relaxed mb-5">{txt.intro}</p>

    <form id="form-contacto" class="space-y-3" novalidate>
      <input
        type="text"
        name="nombre"
        required
        maxlength="80"
        autocomplete="name"
        placeholder={txt.nombre}
        class="w-full rounded-xl border border-neutral-700/60 bg-neutral-900/60 px-3 py-2.5 text-sm text-white placeholder:text-neutral-500 outline-none transition-colors focus:border-sky-500/70"
      />
      <input
        type="email"
        name="email"
        required
        maxlength="120"
        autocomplete="email"
        inputmode="email"
        placeholder={txt.email}
        class="w-full rounded-xl border border-neutral-700/60 bg-neutral-900/60 px-3 py-2.5 text-sm text-white placeholder:text-neutral-500 outline-none transition-colors focus:border-sky-500/70"
      />
      <select
        name="tipo"
        aria-label={txt.tipo}
        class="w-full rounded-xl border border-neutral-700/60 bg-neutral-900/60 px-3 py-2.5 text-sm text-white outline-none transition-colors focus:border-sky-500/70"
      >
        <option value="">{txt.tipo}</option>
        {TIPOS.map((o) => <option value={o.v}>{o[lang] ?? o.es}</option>)}
      </select>
      <select
        name="presupuesto"
        aria-label={txt.presupuesto}
        class="w-full rounded-xl border border-neutral-700/60 bg-neutral-900/60 px-3 py-2.5 text-sm text-white outline-none transition-colors focus:border-sky-500/70"
      >
        <option value="">{txt.presupuesto}</option>
        {PRESUPUESTOS.map((o) => <option value={o.v}>{o[lang] ?? o.es}</option>)}
      </select>
      <textarea
        name="mensaje"
        required
        rows="3"
        maxlength="1500"
        placeholder={txt.ejemplo || txt.mensaje}
        class="w-full resize-none rounded-xl border border-neutral-700/60 bg-neutral-900/60 px-3 py-2.5 text-sm text-white placeholder:text-neutral-500 outline-none transition-colors focus:border-sky-500/70"></textarea>
      <!-- honeypot: invisible para personas -->
      <input type="text" name="web" tabindex="-1" autocomplete="off" aria-hidden="true" class="hidden" />
      <button
        type="submit"
        class="w-full rounded-xl bg-sky-500 px-4 py-2.5 text-sm font-bold text-neutral-950 transition-colors hover:bg-sky-400 disabled:opacity-60"
      >
        {txt.enviar}
      </button>
      <p id="contacto-estado" role="status" aria-live="polite" class="min-h-[1.1rem] text-center text-xs text-neutral-300"></p>
    </form>
  </div>

  <div class="mt-5 grid grid-cols-2 gap-3">
    {links.map((social) => (
      <a
        href={social.href}
        target="_blank"
        rel="noopener noreferrer"
        class={`flex flex-col items-center justify-center p-3 rounded-2xl bg-neutral-800/50 border border-neutral-700/50 transition-all duration-300 hover:border-sky-500/50 hover:bg-neutral-800 group ${social.color}`}
        title={social.name}
      >
        <Icon name={social.icon} class="size-5 mb-1.5 group-hover:scale-110 transition-transform" />
        <span class="text-[10px] font-black uppercase tracking-widest">{social.name}</span>
      </a>
    ))}
  </div>

  <script define:vars={{ txt }}>
    // El formulario del portafolio usa el backend de rsanjur.com (mismo D1 y mismo aviso).
    const form = document.getElementById('form-contacto') as HTMLFormElement | null
    const estado = document.getElementById('contacto-estado')
    const OK = txt.ok
    const ERR = txt.error
    form?.addEventListener('submit', async (e) => {
      e.preventDefault()
      if (!estado) return
      const datos = Object.fromEntries(new FormData(form).entries()) as Record<string, string>
      if (!datos.nombre || !datos.email || !datos.mensaje) {
        estado.textContent = ERR
        return
      }
      const boton = form.querySelector('button[type="submit"]') as HTMLButtonElement | null
      if (boton) boton.disabled = true
      estado.textContent = ''
      try {
        const res = await fetch('https://rsanjur.com/api/contacto', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ ...datos, origen: 'portafolio' }),
        })
        const data = await res.json().catch(() => ({}))
        if (res.ok && data.ok) {
          estado.textContent = OK
          form.reset()
        } else {
          estado.textContent = ERR
        }
      } catch {
        estado.textContent = ERR
      } finally {
        if (boton) boton.disabled = false
      }
    })
  </script>
</section>
