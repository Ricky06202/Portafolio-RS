---
import { Icon } from 'astro-icon/components'
import { useTranslations, getLangFromUrl } from '../i18n/utils'
import { PROFILE } from '../data/profile'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

/** En desarrollo se ve con una dirección de ejemplo; en producción, solo si existe. */
const solana =
  PROFILE.solanaWallet.trim() ||
  (import.meta.env.DEV ? 'DevSampleSolAddressPlaceholder11111111111111111111' : '')

const emails = [
  { label: 'Email', icon: 'lucide:mail', href: `mailto:${PROFILE.email}`, color: 'hover:text-sky-400' },
  { label: 'Crypto', icon: 'lucide:shield-half', href: `mailto:${PROFILE.cryptoEmail}`, color: 'hover:text-emerald-400' },
]
const links = [
  { name: 'GitHub', icon: 'lucide:github', href: PROFILE.github, color: 'hover:text-white' },
  { name: 'LinkedIn', icon: 'lucide:linkedin', href: PROFILE.linkedin, color: 'hover:text-[#0077B5]' },
]
---

<section
  id="contact"
  class="col-span-12 md:col-span-6 lg:col-span-4 bento-card reveal flex flex-col justify-between"
>
  <div>
    <h2 class="text-2xl font-bold mb-4 text-white flex items-center gap-2 font-display">
      <Icon name="lucide:message-circle" class="size-6 text-sky-400" />
      {t('nav.contact')}
    </h2>
    <p class="text-neutral-400 text-sm leading-relaxed mb-6">
      {lang === 'es'
        ? '¿Un proyecto de pagos cripto, un webhook que no duerme o una dApp con backend serio? Hablemos. Respondo rápido y en cualquier zona horaria.'
        : lang === 'fr'
        ? "Un projet de paiements crypto, un webhook qui ne dort jamais ou une dApp avec un vrai backend ? Parlons-en. Réponse rapide, tous fuseaux horaires."
        : 'A crypto payment project, a webhook that never sleeps, or a dApp with a serious backend? Let’s talk. Fast replies in any timezone.'}
    </p>
  </div>

  <div class="grid grid-cols-2 gap-4">
    {emails.map((mail) => (
      <div class="relative group/email">
        <a
          href={mail.href}
          class={`flex flex-col items-center justify-center p-4 rounded-2xl bg-neutral-800/50 border border-neutral-700/50 transition-all duration-300 hover:border-sky-500/50 hover:bg-neutral-800 group ${mail.color} h-full w-full`}
          title={mail.href.replace('mailto:', '')}
        >
          <Icon name={mail.icon} class="size-6 mb-2 group-hover:scale-110 transition-transform" />
          <span class="text-[10px] font-black uppercase tracking-widest">{mail.label}</span>
        </a>
        <button
          type="button"
          class="copy-btn absolute top-2 right-2 p-1.5 rounded-lg bg-neutral-900/80 border border-neutral-700 text-neutral-400 hover:text-sky-400 hover:border-sky-500/50 transition-all md:opacity-0 group-hover/email:opacity-100 shadow-lg"
          data-copy={mail.href.replace('mailto:', '')}
          title={t('wallet.copy')}
        >
          <Icon name="lucide:copy" class="size-3" />
        </button>
      </div>
    ))}
    {links.map((social) => (
      <a
        href={social.href}
        target="_blank"
        rel="noopener noreferrer"
        class={`flex flex-col items-center justify-center p-4 rounded-2xl bg-neutral-800/50 border border-neutral-700/50 transition-all duration-300 hover:border-sky-500/50 hover:bg-neutral-800 group ${social.color}`}
        title={social.name}
      >
        <Icon name={social.icon} class="size-6 mb-2 group-hover:scale-110 transition-transform" />
        <span class="text-[10px] font-black uppercase tracking-widest">{social.name}</span>
      </a>
    ))}
  </div>

  {solana && (
    <div class="web3-only mt-5 rounded-2xl border border-violet-500/25 bg-gradient-to-br from-violet-500/5 to-cyan-500/5 p-4">
      <div class="flex items-center gap-2 mb-3">
        <Icon name="lucide:bitcoin" class="size-4 text-violet-300" />
        <h3 class="text-[10px] font-black uppercase tracking-widest text-violet-300">{t('wallet.title')} · SOL</h3>
      </div>
      <div class="flex items-center gap-3">
        <img id="wallet-qr" class="size-20 rounded-lg bg-white p-1.5 hidden sm:block" alt="QR" width="80" height="80" />
        <div class="min-w-0 flex-1">
          <p class="font-mono text-[10px] text-neutral-300 break-all leading-relaxed" id="wallet-addr" data-addr={solana}>
            {solana}
          </p>
          <div class="flex items-center gap-2 mt-2">
            <button
              type="button"
              class="copy-btn inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-violet-500/15 border border-violet-500/30 text-violet-200 text-[10px] font-bold hover:bg-violet-500/25 transition-colors"
              data-copy={solana}
            >
              <Icon name="lucide:copy" class="size-3" />
              {t('wallet.copy')}
            </button>
            <span class="copied-flash text-[10px] font-bold text-emerald-400 opacity-0 transition-opacity">{t('wallet.copied')}</span>
          </div>
          <p class="text-[9px] text-neutral-500 mt-1.5 uppercase tracking-wider">{t('wallet.note')}</p>
        </div>
      </div>
    </div>
  )}

  <script>
    import QRCode from 'qrcode'

    // Copiar al portapapeles con feedback breve.
    document.querySelectorAll<HTMLElement>('.copy-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const value = btn.dataset.copy
        if (!value) return
        try {
          await navigator.clipboard.writeText(value)
        } catch {
          const ta = document.createElement('textarea')
          ta.value = value
          document.body.appendChild(ta)
          ta.select()
          document.execCommand('copy')
          ta.remove()
        }
        const flash = btn.closest('.relative, div')?.querySelector('.copied-flash') as HTMLElement | null
        if (flash) {
          flash.style.opacity = '1'
          setTimeout(() => (flash.style.opacity = '0'), 1600)
        } else {
          const old = btn.title
          btn.title = '✓'
          setTimeout(() => (btn.title = old), 1600)
        }
      })
    })

    // QR de la wallet generado en cliente (sin servicios externos: la dirección
    // nunca sale del navegador del visitante).
    const addrEl = document.getElementById('wallet-addr')
    const qrImg = document.getElementById('wallet-qr') as HTMLImageElement | null
    const addr = addrEl?.dataset.addr
    if (addr && qrImg) {
      QRCode.toDataURL(addr, { margin: 1, width: 160, color: { dark: '#0f0f14', light: '#ffffff' } })
        .then((url) => {
          qrImg.src = url
        })
        .catch(() => qrImg.classList.add('hidden'))
    }
  </script>
</section>
