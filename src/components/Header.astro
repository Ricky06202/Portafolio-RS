---
import LanguagePicker from './LanguagePicker.astro'
import { useTranslations, getLangFromUrl } from '../i18n/utils'
import { defaultLang } from '../i18n/ui'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
const nav = [
  { href: '#about', label: t('nav.about') },
  { href: '#services', label: t('nav.services') },
  { href: '#skills', label: t('nav.skills') },
  { href: '#experience', label: t('nav.experience') },
  { href: '#projects', label: t('nav.projects') },
  { href: '#contact', label: t('nav.contact') },
]
---

<header class="fixed top-4 left-1/2 -translate-x-1/2 z-50 w-[95%] max-w-5xl">
  <div
    class="bg-neutral-900/80 backdrop-blur-xl border border-neutral-800 rounded-2xl px-4 sm:px-6 h-14 flex items-center justify-between gap-3 shadow-2xl"
  >
    <a
      href={lang === defaultLang ? '/' : `/${lang}/`}
      class="text-xl font-black text-white tracking-tighter hover:text-sky-400 transition-all group shrink-0"
    >
      RS<span class="text-sky-500 group-hover:animate-pulse">.</span>
    </a>

    <nav class="hidden lg:flex items-center gap-5">
      {nav.map((item) => (
        <a
          href={item.href}
          class="text-xs font-bold uppercase tracking-widest text-neutral-400 hover:text-sky-400 transition-colors"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <LanguagePicker />
    </div>
  </div>
</header>
