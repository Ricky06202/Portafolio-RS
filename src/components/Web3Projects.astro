---
import { Icon } from 'astro-icon/components'
import { useTranslations, getLangFromUrl } from '../i18n/utils'
import { web3ProjectsData } from '../i18n/data'
import { PROFILE } from '../data/profile'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

const projects = web3ProjectsData[lang as 'es' | 'en' | 'fr']

/** Links reales por proyecto: SOLO se muestran si el repo/demo existe. */
const links: Record<string, { github?: string; docs?: string }> = {
  'Binance Pay Webhook Listener': { github: PROFILE.web3Repos.binancePayWebhook || undefined },
  'Crypto Transaction Analytics Dashboard': { github: PROFILE.web3Repos.analyticsDashboard || undefined },
  'Self-Hosted Web3 Infrastructure Stack': {
    github: PROFILE.web3Repos.infra,
    docs: `https://${PROFILE.website}`,
  },
}

const statusChip: Record<string, string> = {
  live: `bg-emerald-500/10 text-emerald-400 border-emerald-500/30`,
  building: `bg-amber-500/10 text-amber-400 border-amber-500/30`,
  soon: `bg-cyan-500/10 text-cyan-400 border-cyan-500/30`,
}
const statusDot: Record<string, string> = {
  live: 'bg-emerald-400',
  building: 'bg-amber-400 animate-pulse',
  soon: 'bg-cyan-400',
}
const statusLabel: Record<string, string> = {
  live: t('web3.statusLive'),
  building: t('web3.statusBuilding'),
  soon: t('web3.statusSoon'),
}
---

<section id="web3-projects" class="col-span-12 reveal web3-only">
  <div class="flex items-center gap-4 mb-8">
    <h2 class="text-3xl font-black text-white flex items-center gap-3 font-display">
      <Icon name="lucide:hexagon" class="size-8 text-violet-400" />
      {t('web3.title')}
    </h2>
    <div class="h-px bg-gradient-to-r from-violet-500/50 to-transparent flex-1"></div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {projects.map((project) => (
      <div class:list={[
        'group relative flex flex-col h-full overflow-hidden rounded-3xl border bg-neutral-900/60 backdrop-blur-md p-6 transition-all duration-500 hover:-translate-y-1',
        project.featured ? 'md:col-span-2 lg:col-span-1 web3-gradient-border border-violet-500/40' : 'border-neutral-800 hover:border-cyan-500/40',
      ]}>
        {project.featured && (
          <div class="absolute -top-px left-8 right-8 h-px bg-gradient-to-r from-transparent via-violet-400 to-transparent"></div>
        )}

        <div class="flex items-start justify-between gap-3 mb-4">
          <div class:list={[
            'size-12 rounded-2xl flex items-center justify-center shrink-0 transition-transform group-hover:scale-110',
            project.featured ? 'bg-violet-500/15 text-violet-300' : 'bg-cyan-500/10 text-cyan-300',
          ]}>
            <Icon name={project.icon} class="size-6" />
          </div>
          <span class:list={['inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full border text-[9px] font-black uppercase tracking-widest', statusChip[project.status]]}>
            <span class:list={['size-1.5 rounded-full', statusDot[project.status]]}></span>
            {statusLabel[project.status]}
          </span>
        </div>

        {project.featured && (
          <span class="self-start mb-2 px-2 py-0.5 rounded-md bg-gradient-to-r from-violet-600 to-cyan-500 text-[9px] font-black uppercase tracking-widest text-white">
            {t('web3.featured')}
          </span>
        )}

        <h3 class="text-lg font-black text-white mb-2 group-hover:text-cyan-300 transition-colors font-display">
          {project.title}
        </h3>
        <p class="text-neutral-400 text-sm leading-relaxed mb-4">
          {project.description}
        </p>

        <ul class="space-y-1.5 mb-5 flex-1">
          {project.features.map((feature) => (
            <li class="flex items-start gap-2 text-xs text-neutral-400">
              <Icon name="lucide:check-circle-2" class="size-3.5 mt-0.5 shrink-0 text-emerald-400/80" />
              <span>{feature}</span>
            </li>
          ))}
        </ul>

        <div class="flex flex-wrap gap-1.5 mb-5">
          {project.technologies.map((tech) => (
            <span class="px-2 py-0.5 rounded-md bg-violet-500/10 text-violet-300 text-[10px] font-bold border border-violet-500/20">
              {tech}
            </span>
          ))}
        </div>

        <div class="flex items-center justify-between gap-2 mt-auto">
          <div class="flex gap-2">
            {links[project.title]?.github && (
              <a
                href={links[project.title].github}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-neutral-800 text-white text-xs font-bold border border-neutral-700 hover:border-cyan-500/50 hover:text-cyan-300 transition-all"
              >
                <Icon name="simple-icons:github" class="size-3.5" />
                {t('web3.repo')}
              </a>
            )}
            {links[project.title]?.docs && (
              <a
                href={links[project.title].docs}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-neutral-800 text-white text-xs font-bold border border-neutral-700 hover:border-emerald-500/50 hover:text-emerald-300 transition-all"
              >
                <Icon name="lucide:book-open" class="size-3.5" />
                {t('web3.docs')}
              </a>
            )}
          </div>
          {!links[project.title]?.github && project.status === 'building' && (
            <span class="text-[9px] font-bold uppercase tracking-widest text-neutral-600">
              {t('web3.inProgress')}
            </span>
          )}
        </div>
      </div>
    ))}
  </div>
</section>
