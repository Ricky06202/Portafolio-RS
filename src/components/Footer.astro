---
import { useTranslations, getLangFromUrl } from '../i18n/utils'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
---

<footer class="max-w-7xl mx-auto px-4 md:px-6 mt-20 mb-10 reveal">
  <div
    class="bg-neutral-900/40 backdrop-blur-md border border-neutral-800 rounded-3xl p-8 flex flex-col md:flex-row justify-between items-center gap-6 shadow-xl"
  >
    <div class="text-center md:text-left">
      <p class="text-neutral-400 font-medium">
        {t('footer.developed')}
      </p>
      <p class="text-neutral-500 text-sm mt-1 font-bold">
        © {new Date().getFullYear()} Ricardo Sanjur <span class="text-sky-500 mx-1">/</span> {t('footer.rights')}
      </p>
      <a
        href="https://rsanjur.com"
        target="_blank"
        rel="noopener"
        class="mt-2 inline-flex items-center gap-2.5 rounded-xl border border-white/10 bg-white/[0.04] py-1.5 pl-1.5 pr-3 transition-colors hover:border-white/25 hover:bg-white/[0.08]"
      >
        <span class="grid size-7 shrink-0 place-items-center rounded-md bg-[#0B1220]"><svg width="18" height="18" viewBox="0 0 512 512" aria-hidden="true"><text x="256" y="340" text-anchor="middle" font-family="Inter,system-ui,sans-serif" font-size="252" font-weight="800" letter-spacing="-8" fill="#FFFFFF">RS</text><rect x="196" y="380" width="120" height="26" rx="13" fill="#22D3EE"/></svg></span>
        <span class="text-left text-[11px] leading-[1.15] text-neutral-500">{t('footer.madeby')}<span class="block text-[12px] font-semibold tracking-tight text-sky-400">rsanjur.com</span></span>
      </a>
      <p class="text-neutral-500 text-sm mt-1">
        {t('footer.local')}<a href="https://rsanjur.com" target="_blank" rel="noopener" class="inline-flex min-h-8 items-center px-1 text-sky-400 font-bold hover:underline">rsanjur.com</a>
      </p>
    </div>
    
    <div class="flex items-center gap-4">
       <div class="size-2 rounded-full bg-emerald-500 animate-pulse"></div>
       <span class="text-xs font-black uppercase tracking-widest text-emerald-400">{t('footer.status')}</span>
    </div>
  </div>
</footer>
